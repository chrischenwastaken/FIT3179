{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Vehicle Transfers August 2024",
  "title": "Vehicle Transfers August 2024",
  "width": 400,
  "height": 200,
  "data": {
    "url": "https://raw.githubusercontent.com/chrischenwastaken/FIT3179/refs/heads/main/Monthly_Vehicle_Transfers_August2024.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"filter": "datum.TOTAL1 > 50"},
    {"filter": "datum.NB_YEAR_MFC_VEH != 2024"}
  ],
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "CD_MAKE_VEH1",
          "type": "nominal",
          "title": "Vehicle Make",
          "axis": {"grid": false, "labelAngle": 0}
        },
        "y": {
          "field": "TOTAL1",
          "type": "quantitative",
          "title": "Total Transfers",
          "axis": {"grid": false}
        },
        "color": {
          "field": "NB_YEAR_MFC_VEH",
          "type": "nominal",
          "title": "Build Year"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "red"
      },
      "encoding": {
        "x": {"datum": "KIA   "},
        "y": {"datum": 2000},
        "x2": {"datum": "TOYOTA"},
        "y2": {"datum": 500}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "dy": -5,
        "color": "red"
      },
      "encoding": {
        "x": {"datum": "HOLDEN"},
        "y": {"datum": 2000},
        "text": {"value": "High transfers of old vehicles"}
      }
    }
  ]
}
